{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "mainBinaryName": "coda-echo",
  "version": "../package.json",
  "identifier": "com.coda.echo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Echo",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Keeps a remote branch synced into your local checkout",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwRUJGNzVFODRCOEZGQTIKUldTaS83aUVYdmZyNEl1YVMyMy9mcktSdGt2RlE1VHlyVGNWOWUvdzNhWkc3Tk1LSFF4WkpoeG0K",
      "endpoints": [
        "https://github.com/Coda-Co/echo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
